Algoritmo PROMEDIO_DE_NOTAS
	Escribir "Ingrese la nota del primer examen (20%):"
		Leer nota1

    Escribir "Ingrese la nota del segundo examen (30%):"
        Leer nota2

    Escribir "Ingrese la nota del tercer examen (50%):"
		Leer nota3

    promedio <- (nota1 * 0.20) + (nota2 * 0.30) + (nota3 * 0.50)

    Escribir "El promedio final es:", promedio
FinAlgoritmo


